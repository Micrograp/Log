# Telegram API Credentials (obtain from https://my.telegram.org)
API_ID=123456
API_HASH=your_api_hash_here

# Optional Default Account Credentials
PHONE_NUMBER=+251912345678
TWO_FA_PASSWORD=

# Optional SOCKS5 / SOCKS4 / HTTP Proxy Settings (Step 4 - useful when hosting on cloud servers like Render)
# PROXY_TYPE=SOCKS5
# PROXY_HOST=127.0.0.1
# PROXY_PORT=1080
# PROXY_USER=
# PROXY_PASS=

# Optional Telegram Device Header Overrides (Step 3)
# TELEGRAM_DEVICE_MODEL=Desktop
# TELEGRAM_SYSTEM_VERSION=Windows 11 x64
# TELEGRAM_APP_VERSION=4.16.2 x64

